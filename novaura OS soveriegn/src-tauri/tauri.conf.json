{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Novaura Sovereign OS",
  "version": "1.0.14",
  "identifier": "life.novaura.sovereign",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novaura Sovereign OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://localhost:* https://generativelanguage.googleapis.com https://openrouter.ai https://api.anthropic.com https://api.openai.com; script-src 'self' 'unsafe-inline' blob:; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' asset: https: data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://127.0.0.1:8188 https:; frame-src 'self' blob: data: http://cyprev.localhost cyprev:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/installer.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNThCNDAxRTlGOTc1MEUKUldRT2RmbnBBYlJZN0pWVlZJRUZ4RXBmMk5JdDl2NUp6TDN3UFhVcG4wSlR4Q1FnVlFBQzJMV0MK",
      "endpoints": [
        "https://relay.novaura.life/sovereign/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
